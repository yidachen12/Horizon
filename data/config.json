{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "claude-sonnet-4-6",
    "base_url": "https://llm-proxy.lilithgames.com/v1",
    "api_key_env": "LILITH_LLM_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "languages": ["zh"],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 0,
      "min_score": 0
    },
    "rss": [
      {
        "name": "A Sound Effect",
        "url": "https://feeds.feedburner.com/ASoundEffect",
        "enabled": true,
        "category": "game-audio"
      },
      {
        "name": "Pro Sound Effects Blog",
        "url": "https://blog.prosoundeffects.com/rss.xml",
        "enabled": true,
        "category": "game-audio"
      },
      {
        "name": "Audiokinetic (Wwise) YT",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCuv_-Z-CrnYup-N_dVpdCYg",
        "enabled": true,
        "category": "middleware"
      },
      {
        "name": "FMODTV",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCekk9jO-MTyWEbD2l0m6PTA",
        "enabled": true,
        "category": "middleware"
      },
      {
        "name": "Audio Logs",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCqdVQ6YH_8DCNPSBOCO2WZg",
        "enabled": true,
        "category": "interview"
      },
      {
        "name": "Akash Thakkar",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCr1pdADQRWMks2checkZxBA",
        "enabled": true,
        "category": "education"
      },
      {
        "name": "Marshall McGee",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCIoNgwHpavUi2UnC68cKgbw",
        "enabled": true,
        "category": "sound-design"
      },
      {
        "name": "The Audio Programmer",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCpKb02FsH4WH4X_2xhIoJ1A",
        "enabled": true,
        "category": "audio-programming"
      },
      {
        "name": "Sergio Ronchetti",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCYdqizROsbW1VB502p-k7_g",
        "enabled": true,
        "category": "education"
      },
      {
        "name": "A Sound Effect YT",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UC4g-tOQTJIFkwMPUzHysYbQ",
        "enabled": true,
        "category": "game-audio"
      },
      {
        "name": "GDC",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UC0JB7TSe49lg56u6qH8y_MQ",
        "enabled": true,
        "category": "conference-broad"
      },
      {
        "name": "Game Developer",
        "url": "https://www.gamedeveloper.com/rss.xml",
        "enabled": true,
        "category": "industry-broad"
      },
      {
        "name": "GamesIndustry.biz",
        "url": "https://www.gamesindustry.biz/feed",
        "enabled": true,
        "category": "industry-broad"
      },
      {
        "name": "80 Level",
        "url": "https://80.lv/feed/",
        "enabled": true,
        "category": "industry-broad"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 0
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "filtering": {
    "ai_score_threshold": 4.0,
    "time_window_hours": 24,
    "relevance_gate": {
      "enabled": true,
      "threshold": 5.0,
      "topic": "game audio (游戏音效)"
    }
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "first",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": ["zh"],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "🎮🔊 游戏音效早报 | #{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
